#!/usr/bin/env python3
"""End-to-end smoke test against a RUNNING ai-bridge.

Different from `pytest`: those test the code, this tests the deployment --
is Chrome up, is the session still valid, does a real prompt still work,
has ChatGPT redesigned the page. Exits non-zero on any failure, so it also
serves as the health canary (see systemd/ai-bridge-check.timer).

    bin/ai-bridge-check
"""
import json
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from ai_bridge import config as cfg_mod  # noqa: E402  (stdlib-only import)

GREEN, RED, DIM, OFF = "\033[32m", "\033[31m", "\033[2m", "\033[0m"
passed, failed = [], []


def check(name):
    def wrap(fn):
        t0 = time.monotonic()
        try:
            detail = fn()
            ms = int((time.monotonic() - t0) * 1000)
            print(f"  {GREEN}PASS{OFF} {name} {DIM}({ms}ms){' ' + detail if detail else ''}{OFF}")
            passed.append(name)
        except Exception as exc:
            ms = int((time.monotonic() - t0) * 1000)
            print(f"  {RED}FAIL{OFF} {name} {DIM}({ms}ms){OFF}\n         {exc}")
            failed.append(name)
        return fn
    return wrap


def main():
    cfg = cfg_mod.load()
    base = f"http://{cfg.host}:{cfg.port}"

    def req(path, payload=None, token=cfg.token, method=None, host=None, timeout=300):
        data = json.dumps(payload).encode() if payload is not None else None
        headers = {"Content-Type": "application/json"}
        if token:
            headers["Authorization"] = f"Bearer {token}"
        if host:
            headers["Host"] = host
        r = urllib.request.Request(base + path, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(r, timeout=timeout) as resp:
                return resp.status, json.load(resp)
        except urllib.error.HTTPError as e:
            return e.code, json.load(e)

    print(f"\nai-bridge check  {DIM}{base}{OFF}\n")
    print("infrastructure")

    @check("browser reachable on CDP")
    def _():
        url = cfg.cdp_url.rstrip("/") + "/json/version"
        with urllib.request.urlopen(url, timeout=5) as r:
            return json.load(r).get("Browser", "")

    @check("service responding")
    def _():
        status, body = req("/health", token=None, timeout=10)
        assert status == 200, f"status {status}"
        globals()["_health"] = body

    @check("ChatGPT session authenticated")
    def _():
        h = globals().get("_health")
        assert h is not None, "no health report -- the service is down"
        assert h.get("authenticated"), "not logged in -- log in via bin/start-chrome.sh"

    @check("no Cloudflare challenge pending")
    def _():
        h = globals().get("_health")
        assert h is not None, "no health report -- the service is down"
        assert not h.get("challenge"), "solve the challenge in the Chrome window"

    @check("page selectors intact")
    def _():
        status, body = req("/health/dom", timeout=30)
        assert status == 200, f"status {status}"
        broken = [k for k, v in body.get("selectors", {}).items() if not v]
        assert not broken, f"drifted: {broken} -- fix ai_bridge/selectors.py"

    print("\nsecurity")

    @check("rejects a bad token")
    def _():
        status, body = req("/ask", {"instruction": "x"}, token="wrong", timeout=10)
        assert status == 401, f"status {status}"
        assert body["error"]["code"] == "UNAUTHORIZED", body

    @check("rejects a non-loopback Host")
    def _():
        status, body = req("/ask", {"instruction": "x"}, host="evil.example.com", timeout=10)
        assert status == 403, f"status {status}"

    @check("rejects oversized input")
    def _():
        status, body = req("/ask", {"instruction": "x", "input": "y" * (cfg.max_input_bytes + 1)}, timeout=10)
        assert status == 413, f"status {status}"

    print("\nround trips")

    @check("answers a prompt")
    def _():
        status, body = req("/ask", {"instruction": "Reply with exactly the word: pong"})
        assert status == 200, body
        assert "pong" in body["response"].lower(), body["response"][:80]
        globals()["_ask"] = body
        return f"{body['duration_ms']}ms"

    @check("answer came from the SSE stream, not the DOM fallback")
    def _():
        # Reuses the answer above rather than asking again. Repeated near-identical
        # short prompts are what trips ChatGPT's "Too many requests" throttle, and a
        # canary that provokes the failure it is watching for is worse than useless.
        # Assert the extraction path, not the model's obedience -- asking for a
        # tagged code block and checking for ```python is flaky, because the
        # model sometimes emits a bare fence regardless of instruction.
        body = globals().get("_ask")
        assert body is not None, "no answer to inspect -- the round trip above failed"
        assert body.get("source") == "stream", \
            f"source={body.get('source')!r} -- SSE parsing degraded, check ai_bridge/stream.py"
        return f"source={body['source']}"

    @check("async job completes")
    def _():
        status, body = req("/ask?async=1", {"instruction": "Reply with exactly: ok"})
        assert status == 202, body
        job = body["job_id"]
        for _ in range(150):
            status, got = req(f"/jobs/{job}", timeout=10)
            if got["status"] in ("done", "failed", "cancelled"):
                break
            time.sleep(2)
        assert got["status"] == "done", got
        return got["status"]

    total = len(passed) + len(failed)
    if failed:
        print(f"\n{RED}{len(failed)}/{total} failed{OFF}: {', '.join(failed)}\n")
        return 1
    print(f"\n{GREEN}all {total} checks passed{OFF}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
